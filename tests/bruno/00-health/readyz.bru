meta {
  name: GET readyz
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/readyz
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.status: eq ok
}

tests {
  test("readiness reflects an actual DB check, not just process liveness", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("ok");
  });
}
