meta {
  name: POST /mcp with an incorrect X-MCP-API-Key is rejected
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json, text/event-stream
  X-MCP-API-Key: definitely-not-the-real-mcp-key
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {
      "protocolVersion": "2024-11-05",
      "capabilities": {},
      "clientInfo": { "name": "bruno-acceptance", "version": "1.0.0" }
    }
  }
}

assert {
  res.status: eq 401
}
