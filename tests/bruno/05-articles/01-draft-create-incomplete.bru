meta {
  name: POST create incomplete draft (title only) is permitted
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/admin/articles
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: {{apiPublicOrigin}}
  X-CSRF-Token: {{adminCsrfToken}}
}

body:json {
  {
    "title": "Draft uji coba belum lengkap"
  }
}

assert {
  res.status: eq 201
  res.body.data.publishedAt: eq null
  res.body.data.revision: eq 1
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("articleId", res.getBody().data.documentId);
    bru.setVar("articleRevision", res.getBody().data.revision);
  }
}

tests {
  test("new article starts unpublished with no publishedRevision", function () {
    const data = res.getBody().data;
    expect(data.publishedAt).to.equal(null);
    expect(data.publishedRevision).to.equal(null);
    expect(data).to.include.all.keys("documentId", "revision", "createdAt", "updatedAt");
  });
}
