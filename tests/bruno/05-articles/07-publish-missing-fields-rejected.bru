meta {
  name: POST publish incomplete draft is rejected server-side
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/admin/articles/{{articleThrowawayId}}/publish
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: {{apiPublicOrigin}}
  X-CSRF-Token: {{adminCsrfToken}}
}

body:json {
  {
    "revision": {{articleThrowawayRevision}}
  }
}

assert {
  res.status: eq 422
}

tests {
  test("incomplete draft cannot be published, but draft save remains allowed (US-04/T-20)", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().error.code).to.be.a("string");
  });
}
