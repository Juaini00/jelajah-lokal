meta {
  name: POST generate as editor who does not own/cannot access this article is rejected
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/admin/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: {{apiPublicOrigin}}
}

body:json {
  {
    "username": "{{editorUsername}}",
    "password": "{{editorPassword}}"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("editorCsrfToken", res.getBody().data.csrfToken);
  }
}

tests {
  test("editor session established for the ownership probe", function () {
    expect(res.getBody().data.principal.role).to.equal("editor");
  });
}
