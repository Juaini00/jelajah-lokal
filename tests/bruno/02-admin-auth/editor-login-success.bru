meta {
  name: POST editor login (secondary principal for ownership tests)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/admin/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: {{apiPublicOrigin}}
}

body:json {
  {
    "username": "{{editorUsername}}",
    "password": "{{editorPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.data.principal.username: eq {{editorUsername}}
  res.body.data.principal.role: eq editor
}

script:post-response {
  if (res.getStatus() === 200) {
    const data = res.getBody().data;
    bru.setVar("editorCsrfToken", data.csrfToken);
    bru.setVar("editorPrincipalId", data.principal.documentId);
    // Switching the active session cookie to the editor's; requests tagged
    // "as admin" later re-login via admin-login-success before running, see
    // 05-articles/zz-relogin-admin.bru.
  }
}

tests {
  test("editor principal is distinct from admin", function () {
    expect(res.getBody().data.principal.documentId).to.not.equal(bru.getVar("adminPrincipalId"));
  });
}
