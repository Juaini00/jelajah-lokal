meta {
  name: POST admin login with invalid credentials
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/admin/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: {{apiPublicOrigin}}
}

body:json {
  {
    "username": "{{adminUsername}}",
    "password": "definitely-the-wrong-password-123"
  }
}

assert {
  res.status: eq 401
}

tests {
  test("invalid credentials never leak which field was wrong", function () {
    const body = res.getBody();
    expect(body.error).to.exist;
    expect(body.error.code).to.not.include("PASSWORD");
    expect(body.error.code).to.not.include("USERNAME");
  });

  test("no session cookie set on failed login", function () {
    const setCookie = res.getHeader("set-cookie");
    expect(setCookie).to.be.undefined;
  });
}
