meta {
  name: POST create main category
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/admin/categories
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: {{apiPublicOrigin}}
  X-CSRF-Token: {{adminCsrfToken}}
}

body:json {
  {
    "name": "Destinasi Uji",
    "slug": "destinasi-uji-{{runNonce}}",
    "description": "Kategori untuk pengujian otomatis Bruno.",
    "order": 1
  }
}

assert {
  res.status: eq 201
  res.body.data.name: eq Destinasi Uji
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("categoryMainId", res.getBody().data.documentId);
    bru.setVar("categoryMainSlug", res.getBody().data.slug);
  }
}

tests {
  test("category DTO matches contract shape", function () {
    const data = res.getBody().data;
    expect(data).to.include.all.keys("documentId", "name", "slug", "description", "order");
  });
}
