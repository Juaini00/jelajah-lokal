meta {
  name: POST create main author
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/admin/authors
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: {{apiPublicOrigin}}
  X-CSRF-Token: {{adminCsrfToken}}
}

body:json {
  {
    "name": "Penulis Uji Bruno",
    "slug": "penulis-uji-bruno-{{runNonce}}",
    "bio": "Akun penulis publik yang dipakai khusus untuk pengujian otomatis.",
    "avatarMediaDocumentId": null
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("authorMainId", res.getBody().data.documentId);
    bru.setVar("authorMainSlug", res.getBody().data.slug);
  }
}

tests {
  test("author DTO matches contract shape and excludes admin identity", function () {
    const data = res.getBody().data;
    expect(data).to.include.all.keys("documentId", "name", "slug", "bio", "avatarMediaDocumentId");
    expect(data).to.not.have.any.keys("principalId", "email", "passwordHash");
  });
}
