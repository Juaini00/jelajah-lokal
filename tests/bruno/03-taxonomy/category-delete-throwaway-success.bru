meta {
  name: DELETE unreferenced throwaway category succeeds
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/api/admin/categories/{{categoryThrowawayId}}
  body: none
  auth: none
}

headers {
  Origin: {{apiPublicOrigin}}
  X-CSRF-Token: {{adminCsrfToken}}
}

assert {
  res.status: eq 200
  res.body.data.deleted: eq true
}
