meta {
  name: POST create throwaway (unreferenced) category
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/admin/categories
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: {{apiPublicOrigin}}
  X-CSRF-Token: {{adminCsrfToken}}
}

body:json {
  {
    "name": "Kategori Sekali Pakai",
    "slug": "kategori-sekali-pakai-{{runNonce}}",
    "description": "",
    "order": 99
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("categoryThrowawayId", res.getBody().data.documentId);
  }
}
