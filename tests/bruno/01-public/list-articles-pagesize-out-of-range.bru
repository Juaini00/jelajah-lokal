meta {
  name: GET public articles rejects pageSize above 12
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/public/articles?pageSize=50
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{apiContentToken}}
}

params:query {
  pageSize: 50
}

assert {
  res.status: eq 400
  res.body.error.code: eq INVALID_REQUEST
}
