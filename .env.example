# Public Astro server. These values are server-only, never browser-public.
SITE_URL=http://127.0.0.1:4321
API_URL=http://127.0.0.1:8000
API_CONTENT_TOKEN=
API_REQUEST_TIMEOUT_MS=5000
HOST=127.0.0.1
PORT=4321
NODE_ENV=development

# FastAPI and PostgreSQL. Production uses Neon TLS connection strings.
ENVIRONMENT=development
API_PUBLIC_URL=http://127.0.0.1:8000
DATABASE_URL=
TEST_DATABASE_URL=
DATABASE_DIRECT_URL=
POSTGRES_USER=jelajah
POSTGRES_PASSWORD=
POSTGRES_DB=jelajah
POSTGRES_PORT=55438
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Private editor: HttpOnly revocable session, explicit same-origin mutations.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_COOKIE_NAME=jelajah_session
ADMIN_COOKIE_SECURE=false
ADMIN_ALLOWED_ORIGINS=["http://127.0.0.1:8000"]
CORS_ALLOWED_ORIGINS=[]
MEDIA_ALLOWED_HOSTS=["res.cloudinary.com"]

# Backend-only Gemini metadata assistance. Manual editing always works.
GEMINI_MODEL=
GEMINI_API_KEY=
# Reserved input credential; NOT forwarded to standard Google APIs.
GEMINI_HEADER_AUTHORIZATION=
AI_ENABLED=false
AI_MOCK_MODE=false
AI_DAILY_LIMIT=20
AI_MAX_INPUT_TOKENS=2000
AI_MAX_OUTPUT_TOKENS=500
AI_TIMEOUT_MS=30000
AI_CACHE_TTL_DAYS=7
AI_PROMPT_VERSION=editorial-metadata-v1

# Protected application MCP. Reuse the supplied key, never a browser token.
MCP_API_KEY=
MCP_ENABLED=true
MCP_ALLOWED_HOSTS=["127.0.0.1:8000","localhost:8000"]

# Backend-only official Cloudinary runtime uploads.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_FOLDER=jelajah-lokal

# Optional deployment configuration: set in provider secret stores.
# Production origins, Secure cookies and Neon connection strings replace local values.
